# Chiru MultiTracker - configuração do Dynu
# Não coloque sua senha real neste arquivo no GitHub.
# Copie para .env apenas no Termux e preencha DDNS_PASSWORD localmente.

DDNS_HOST=chirusanrestart.freeddns.org
DDNS_USERNAME=chiruzinha
DDNS_PASSWORD=

# Verificação a cada 5 minutos (300000 ms)
DDNS_UPDATE_INTERVAL_MS=300000

# Timeout das requisições em milissegundos
DDNS_TIMEOUT_MS=10000
