# Chiru MultiTracker - modelo de configuração local
# Copie este arquivo para .env no Termux. Nunca coloque tokens/senhas reais no GitHub.

# Dados do domínio DDNS já informados (referência; o atualizador atual ainda não os usa diretamente)
DDNS_HOST=chirusanrestart.freeddns.org
DDNS_USERNAME=chiruzinha

# URL OFICIAL de atualização IPv6 do provedor. Ainda precisa ser confirmada.
# Se a documentação aceitar o IP como parâmetro, use {ip} no lugar exato documentado.
# Exemplo FICTÍCIO: https://ddns.example.invalid/update?token=SEU_TOKEN&ipv6={ip}
DDNS_IPV6_UPDATE_URL=

# Intervalo entre verificações: 300000 ms = 5 minutos
DDNS_UPDATE_INTERVAL_MS=300000

# Timeout das requisições: 10000 ms = 10 segundos
DDNS_TIMEOUT_MS=10000
