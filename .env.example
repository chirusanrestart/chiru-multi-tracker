# Copie para .env e preencha com a URL oficial de atualização do seu provedor DDNS.
# Não compartilhe este arquivo nem envie tokens/senhas ao GitHub.
# Se o provedor aceitar o IP explicitamente, use {ip} no lugar indicado pela documentação.
# Exemplo FICTÍCIO: https://ddns.example.invalid/update?token=SEU_TOKEN&ipv6={ip}
DDNS_IPV6_UPDATE_URL=
DDNS_UPDATE_INTERVAL_MS=300000
DDNS_TIMEOUT_MS=10000
